---
export const prerender = false;

import BaseLayout from '@layouts/BaseLayout.astro';
import BreadcrumbSchema from '@components/seo/BreadcrumbSchema.astro';
import TextHero from '@components/common/TextHero.astro';
import BlogCard from '@components/blog/BlogCard.astro';
import { createClient } from '@sanity/client';
import { pageUrl } from '@data/structuredData';

const sanityClient = createClient({
  projectId: '7b9lcco4',
  dataset: 'production',
  useCdn: true,
  apiVersion: '2024-01-01',
  token: import.meta.env.SANITY_READ_TOKEN || import.meta.env.SANITY_API_TOKEN,
});

let posts: any[] = [];
let rawCategories: any[] = [];
let fetched = false;
try {
  // Future-dated and slug-less posts would otherwise be listed — and linked — early.
  posts = await sanityClient.fetch(`*[_type == "blogPost" && !(_id in path("drafts.**")) && publishedAt != null && publishedAt <= now() && defined(slug.current)] | order(publishedAt desc) {
    _id, title, slug, excerpt, publishedAt,
    mainImage { asset-> { _id, url } },
    category-> { title, slug },
    author-> { name },
    "estimatedReadingTime": round(length(pt::text(body)) / 500)
  }`);
  rawCategories = await sanityClient.fetch(`*[_type == "blogCategory"] {
    title, slug,
    "postCount": count(*[_type == "blogPost" && !(_id in path("drafts.**")) && publishedAt != null && publishedAt <= now() && defined(slug.current) && references(^._id)])
  }`);
  fetched = true;
} catch (e) {
  // Sanity 접속 실패 시 빈 목록 표시
}

// This route renders per request, so without these headers every visit ran the
// function (x-vercel-cache: MISS). Vercel's CDN may now keep it for a minute and
// serve the stale copy while it refreshes; a new post still appears within a
// minute, and the deploy every admin save triggers starts a fresh cache anyway.
// Browsers always revalidate. A failed Sanity fetch (empty list) is not cached.
if (fetched) {
  Astro.response.headers.set('Cache-Control', 'public, max-age=0, must-revalidate');
  Astro.response.headers.set('Vercel-CDN-Cache-Control', 'public, max-age=60, stale-while-revalidate=86400');
  Astro.response.headers.set('Vercel-Cache-Tag', 'blog');
}

const totalCount = posts.length;

const postListNode = {
  '@type': 'ItemList',
  '@id': `${pageUrl('/blog')}#posts`,
  numberOfItems: posts.length,
  itemListElement: posts.map((p: any, i: number) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: pageUrl(`/blog/${p.slug.current}`),
    name: p.title,
  })),
};
const categories = [
  { title: '전체', slug: { current: 'all' }, postCount: totalCount },
  ...rawCategories.filter((c: any) => c.postCount > 0),
];
---

<BaseLayout
  title="포토부스 대여 가이드 · 현장 사례 | 피키픽 PICKYPIC"
  description="포토부스 대여를 준비하는 담당자를 위한 체크리스트, 기기 고르는 법, 브랜드 팝업·기업 행사 현장 사례를 정리합니다."
  pageType="CollectionPage"
  schema={[postListNode]}
>
  <BreadcrumbSchema items={[
    { name: '홈', href: '/' },
    { name: '블로그', href: '/blog' },
  ]} />

  <TextHero
    subtitle="Blog"
    title="포토부스 대여 가이드 · 현장 사례"
    description="포토부스에 대한 트렌드, 가이드, 사례를 공유합니다."
    titleI18n="blog.title"
    descriptionI18n="blog.description"
  />

  <section class="py-20 lg:py-28 bg-white">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <!-- Category Filter -->
      <div class="flex flex-wrap justify-center gap-2 mb-12 lg:mb-16 gs-fade-up" id="blog-filter">
        {categories.map((cat) => (
          <button
            class:list={[
              'px-4 py-2 text-xs font-medium tracking-[0.05em] transition-all duration-300 cursor-pointer border',
              cat.slug.current === 'all'
                ? 'bg-primary text-white border-primary'
                : 'bg-white text-secondary border-border-light hover:border-primary hover:text-primary',
            ]}
            data-filter={cat.slug.current}
          >
            {cat.title}
            <span class="ml-1 text-[10px] opacity-60">{cat.postCount}</span>
          </button>
        ))}
      </div>

      <!-- Blog Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 lg:gap-10 gs-stagger" id="blog-grid">
        {posts.map((post, i) => (
          <div data-category={post.category?.title}>
            <BlogCard post={post} eager={i === 0} />
          </div>
        ))}
      </div>

      <!-- Empty State -->
      <div id="blog-empty" class="hidden text-center py-16">
        <p class="text-secondary" data-i18n="blog.empty_category">해당 카테고리의 포스트가 없습니다.</p>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  function initBlogFilter() {
    const filterContainer = document.getElementById('blog-filter');
    const grid = document.getElementById('blog-grid');
    const empty = document.getElementById('blog-empty');
    if (!filterContainer || !grid) return;

    const buttons = filterContainer.querySelectorAll('button');
    const items = grid.querySelectorAll<HTMLElement>('[data-category]');

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = btn.getAttribute('data-filter');

        buttons.forEach((b) => {
          b.classList.remove('bg-primary', 'text-white', 'border-primary');
          b.classList.add('bg-white', 'text-secondary', 'border-border-light');
        });
        btn.classList.remove('bg-white', 'text-secondary', 'border-border-light');
        btn.classList.add('bg-primary', 'text-white', 'border-primary');

        let visibleCount = 0;
        items.forEach((item) => {
          if (filter === 'all' || item.dataset.category === btn.textContent?.trim().split('\n')[0]?.trim()) {
            item.style.display = '';
            visibleCount++;
          } else {
            item.style.display = 'none';
          }
        });

        if (empty) {
          empty.classList.toggle('hidden', visibleCount > 0);
        }
      });
    });
  }

  document.addEventListener('DOMContentLoaded', initBlogFilter);
  document.addEventListener('astro:after-swap', initBlogFilter);
</script>
