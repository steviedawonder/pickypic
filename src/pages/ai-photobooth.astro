---
import BaseLayout from '@layouts/BaseLayout.astro';
import BreadcrumbSchema from '@components/seo/BreadcrumbSchema.astro';

// Korean only for now — no /en/ counterpart, so it stays out of i18nPairs.
const faqItems = [
  { question: 'AI 사진은 얼마나 걸리나요?', answer: '한 장에 20초 안팎입니다. 인화물은 그 자리에서 나오고, 같은 사진을 QR로 휴대폰에도 담아 갑니다.' },
  { question: '얼굴이 다른 사람처럼 바뀌지는 않나요?', answer: '얼굴은 그대로 두고 옷·배경·분위기만 바꿉니다. 여러 명이 함께 찍어도 각자의 얼굴을 지킵니다.' },
  { question: '우리 브랜드에 맞는 연출을 새로 만들 수 있나요?', answer: '네. 견본에 없는 방향도 컨셉을 알려 주시면 그에 맞춰 사진 연출·인화 틀·부스 화면·QR 페이지를 하나로 설계합니다. 컨셉 확정 후 약 3주가 걸립니다.' },
  { question: '브랜드 캐릭터나 로고도 AI로 다시 그리나요?', answer: '아니요. 공식 파일을 주시면 인화 틀의 정해진 자리에 원본 그대로 넣습니다.' },
  { question: '비용은 어떻게 되나요?', answer: '행사 규모와 기간, 연출 범위에 따라 달라져 견적으로 안내합니다. 행사 한 건과 원하시는 느낌만 알려 주시면 시안을 먼저 보여 드립니다.' },
];
---

<BaseLayout
  title="AI 포토부스 | 피키픽 PICKYPIC"
  description="한 장 찍으면 옷·배경·분위기가 바뀌는 피키픽 AI 포토부스. 얼굴은 그대로, 한 장에 20초 안팎. 행사 컨셉에 맞춰 사진 연출·인화 틀·부스 화면·QR 페이지를 함께 설계합니다."
  ogImage="/images/ai-photobooth/hero-booth.jpg"
>
  <link slot="head" rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@112,800&family=Gothic+A1:wght@400;500;700;800;900&display=swap" />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqItems.map((f) => ({
      "@type": "Question",
      "name": f.question,
      "acceptedAnswer": { "@type": "Answer", "text": f.answer },
    })),
  })} />

  <BreadcrumbSchema items={[
    { name: '홈', href: '/' },
    { name: 'AI 포토부스', href: '/ai-photobooth' },
  ]} />

  <div class="ai-page">
  
  <!-- HERO -->
  <section class="hero">
    <div class="wrap">
      <div class="hero__grid">
        <div class="hero__copy">
          <span class="tag">피키픽 포토부스 AI 신기능</span>
          <h1>한 장 찍으면,<br><span class="mark">완전히 다른 내가</span><br>나옵니다</h1>
          <p class="lead">얼굴은 그대로 두고 옷·배경·분위기만 바꿉니다. 팝업마다, 시즌마다, 장소마다 행사 컨셉에 맞춰 새로 만드는 맞춤 AI 포토부스입니다.</p>
          <div class="btns">
            <a class="btn btn--main" href="/rental?ai=1">렌탈 문의하기</a>
            <a class="btn btn--ghost" href="#samples">연출 견본 보기</a>
          </div>
        </div>
        <div class="hero__pic">
          <img class="hero__main" src="/images/ai-photobooth/hero-booth.jpg" width="1100" height="1366" alt="BASIC과 AI 촬영 모드를 고르는 화면이 켜진 보라색 피키픽 포토부스">
          <img class="hero__sub" src="/images/ai-photobooth/hero-scene.jpg" width="1080" height="950" alt="매장에 놓인 원목 피키픽 포토부스 앞에서 한복 연출로 인화된 AI 사진 두 장을 들고 웃는 사람들">
        </div>
      </div>
      <div class="facts">
        <div><b>20<span>초 안팎</span></b><small>사진 한 장이 바뀌는 데 걸리는 시간</small></div>
        <div><b>4<span>개 언어</span></b><small>한국어·영어·일본어·스페인어 기본 탑재</small></div>
        <div><b>1~4<span>명+</span></b><small>여러 명이 함께 찍어도 각자의 얼굴 그대로</small></div>
        <div><b>4<span>가지</span></b><small>사진 연출·인화 틀·부스 화면·QR 페이지를 한 컨셉으로</small></div>
      </div>
    </div>
  </section>
  
  <!-- 연출 견본 -->
  <section class="band band--sheet" id="samples">
    <div class="wrap">
      <div class="head">
        <span class="tag">연출 견본</span>
        <h2>이렇게 찍으면, 이렇게 나옵니다</h2>
        <p class="lead">왼쪽 위 작은 사진이 현장에서 찍은 촬영본입니다. 연출을 눌러 결과를 비교해 보세요.</p>
      </div>
      <div class="scenes">
        <figure class="stage" style="margin:0">
          <img id="stageImg" src="/images/ai-photobooth/scene-hanbok.jpg" width="1000" height="1241" alt="한옥 마당에서 한복을 입은 모습으로 바뀐 AI 적용 사진">
          <span class="inset"><img id="stageBefore" src="/images/ai-photobooth/before-hanbok.jpg" width="420" height="521" alt="포토부스에서 찍은 촬영 원본"><em>촬영본</em></span>
          <figcaption>AI 기능 적용본</figcaption>
        </figure>
        <div>
          <div class="picker" role="tablist" aria-label="연출 선택">
            <button class="pick" role="tab" aria-selected="true" data-img="scene-hanbok" data-alt="한옥 배경에 한복을 입은 모습으로 바뀐 AI 적용 사진"><i></i><strong>한옥 배경 + 한복</strong><span>해외 여행자가 많이 찾는 고궁·관광지에 좋습니다. 한국 여행을 기념하는 한 장이 됩니다.</span></button>
            <button class="pick" role="tab" aria-selected="false" data-img="scene-stadium" data-alt="야구장 관중석에서 유니폼 점퍼를 입고 응원하는 모습으로 바뀐 AI 적용 사진"><i></i><strong>스포츠 경기장 + 유니폼</strong><span>스포츠 행사나 관중이 많이 모이는 경기장에 좋습니다. 구단·대회 유니폼에 맞춰 제작합니다.</span></button>
            <button class="pick" role="tab" aria-selected="false" data-img="scene-job" data-alt="어린이가 경찰관이 된 어른의 모습으로 바뀐 AI 적용 사진"><i></i><strong>미래 직업</strong><span>학교 진로 탐방이나 어린이가 많이 오는 행사에 좋습니다. 아이가 꿈꾸는 직업의 어른이 됩니다.</span></button>
            <button class="pick" role="tab" aria-selected="false" data-img="scene-xmas" data-alt="어린이가 크리스마스 요정 옷을 입은 모습으로 바뀐 AI 적용 사진"><i></i><strong>크리스마스 요정</strong><span>연말 행사나 가족 단위 방문이 많은 놀이공원에 좋습니다. 시즌마다 연출을 바꿀 수 있습니다.</span></button>
            <button class="pick" role="tab" aria-selected="false" data-img="scene-y2k" data-alt="2000년대 웹캠으로 찍은 듯한 방 안 사진으로 바뀐 AI 적용 사진"><i></i><strong>Y2K 웹캠</strong><span>대학 축제나 레트로한 분위기의 팝업에 좋습니다. 2000년대 웹캠 화질과 방 풍경까지 살립니다.</span></button>
          </div>
          </div>
      </div>
    </div>
  </section>
  
  <!-- 원본 한 장 -->
  <section class="band">
    <div class="wrap">
      <div class="head">
        <span class="tag">원본 한 장에서</span>
        <h2>같은 한 장이<br>열두 가지로 바뀝니다</h2>
        <p class="lead">아래 열두 장은 모두 왼쪽 원본 한 장에서 만든 시안입니다. 카드형 연출은 인화물 자체가 한 장의 카드가 됩니다.</p>
      </div>
      <div class="one">
        <figure class="one__src"><img src="/images/ai-photobooth/one-original.jpg" width="640" height="954" alt="회색 배경 스튜디오에서 서 있는 촬영 원본"><figcaption><span class="tag">현장에서 찍은 한 장</span></figcaption></figure>
        <div class="one__grid">
          <figure><img loading="lazy" src="/images/ai-photobooth/one-figure.jpg" width="560" height="835" alt="같은 인물이 피규어 상자 연출로 바뀐 사진"><figcaption><b>피규어 상자</b>포장 상자처럼 보이는 인화물</figcaption></figure>
          <figure><img loading="lazy" src="/images/ai-photobooth/one-card.jpg" width="560" height="835" alt="같은 인물이 수집 카드 연출로 바뀐 사진"><figcaption><b>수집 카드</b>카드처럼 보이는 인화물</figcaption></figure>
          <figure><img loading="lazy" src="/images/ai-photobooth/one-editorial.jpg" width="560" height="835" alt="같은 인물이 브랜드 화보 연출로 바뀐 사진"><figcaption><b>브랜드 화보</b>그날 입은 옷으로</figcaption></figure>
          <figure><img loading="lazy" src="/images/ai-photobooth/one-santa.jpg" width="560" height="835" alt="같은 인물이 산타 기념사진 연출로 바뀐 사진"><figcaption><b>산타 기념사진</b>겨울 시즌</figcaption></figure>
          <figure><img loading="lazy" src="/images/ai-photobooth/one-jumbotron.jpg" width="560" height="835" alt="같은 인물이 중계 화면 연출로 바뀐 사진"><figcaption><b>중계 화면</b>경기장·스포츠 행사</figcaption></figure>
          <figure><img loading="lazy" src="/images/ai-photobooth/one-webcam.jpg" width="560" height="835" alt="같은 인물이 2000년대 웹캠 연출로 바뀐 사진"><figcaption><b>2000년대 웹캠</b>레트로 팝업</figcaption></figure>
          <figure><img loading="lazy" src="/images/ai-photobooth/one-idol.jpg" width="560" height="835" alt="같은 인물이 아이돌이 된 나 연출로 바뀐 사진"><figcaption><b>아이돌이 된 나</b>팬덤·음악 행사</figcaption></figure>
          <figure><img loading="lazy" src="/images/ai-photobooth/one-future.jpg" width="560" height="835" alt="같은 인물이 미래의 나 연출로 바뀐 사진"><figcaption><b>미래의 나</b>25년 뒤의 얼굴</figcaption></figure>
          <figure><img loading="lazy" src="/images/ai-photobooth/one-hanbok.jpg" width="560" height="835" alt="같은 인물이 한복 연출로 바뀐 사진"><figcaption><b>한복</b>외국인 고객</figcaption></figure>
          <figure><img loading="lazy" src="/images/ai-photobooth/one-yearbook.jpg" width="560" height="835" alt="같은 인물이 졸업앨범 연출로 바뀐 사진"><figcaption><b>졸업앨범</b>90년대 사진관</figcaption></figure>
          <figure><img loading="lazy" src="/images/ai-photobooth/one-camcorder.jpg" width="560" height="835" alt="같은 인물이 옛날 캠코더 연출로 바뀐 사진"><figcaption><b>옛날 캠코더</b>Y2K 팝업</figcaption></figure>
          <figure><img loading="lazy" src="/images/ai-photobooth/one-pet.jpg" width="560" height="835" alt="같은 인물이 반려동물 연출로 바뀐 사진"><figcaption><b>반려동물</b>동반 행사</figcaption></figure>
        </div>
      </div>
    </div>
  </section>
  
  <!-- 다인 촬영 -->
  <section class="band band--sheet">
    <div class="wrap">
      <div class="head">
        <span class="tag">다인 촬영도 문제 없이 AI 적용</span>
        <h2>가족도, 친구도, 연인도<br>한 장에서 함께 바뀝니다</h2>
        <p class="lead">한 장에 몇 명이 있든 각자의 얼굴을 지킨 채 바꿉니다.</p>
      </div>
      <div class="grows">
        <div class="grow">
          <div class="grow__txt"><h3>가족 넷</h3><p>부모는 나이가 들고 아이는 자란 모습처럼, 사람마다 다르게 바꿉니다.</p></div>
          <div class="grow__imgs">
            <figure><img loading="lazy" src="/images/ai-photobooth/grp-family.jpg" width="560" height="835" alt="스튜디오에서 찍은 부모와 두 아이"><figcaption>있는 그대로</figcaption></figure>
            <span class="arrow" aria-hidden="true">→</span>
            <figure><img loading="lazy" src="/images/ai-photobooth/grp-family-hanbok.jpg" width="560" height="835" alt="한옥 앞에서 한복을 입은 가족"><figcaption><b>한복 가족사진</b> 명절·외국인 가족</figcaption></figure><figure><img loading="lazy" src="/images/ai-photobooth/grp-family-future.jpg" width="560" height="835" alt="아이들이 어른이 된 20년 뒤의 가족"><figcaption><b>20년 뒤 우리 가족</b> 아이는 어른이 되고</figcaption></figure>
          </div>
        </div>
        <div class="grow">
          <div class="grow__txt"><h3>친구 넷</h3><p>넷이 같은 무대에 서거나 같은 시절로 돌아갑니다.</p></div>
          <div class="grow__imgs">
            <figure><img loading="lazy" src="/images/ai-photobooth/grp-friends.jpg" width="560" height="835" alt="스튜디오에서 찍은 친구 네 명"><figcaption>있는 그대로</figcaption></figure>
            <span class="arrow" aria-hidden="true">→</span>
            <figure><img loading="lazy" src="/images/ai-photobooth/grp-friends-idol.jpg" width="560" height="835" alt="아이돌 그룹 앨범 재킷처럼 바뀐 친구 네 명"><figcaption><b>아이돌 데뷔</b> 앨범 재킷 사진</figcaption></figure><figure><img loading="lazy" src="/images/ai-photobooth/grp-friends-y2k.jpg" width="560" height="835" alt="PC방 웹캠 앞에 모인 듯한 친구 네 명"><figcaption><b>Y2K 친구들</b> PC방 웹캠</figcaption></figure>
          </div>
        </div>
        <div class="grow">
          <div class="grow__txt"><h3>연인</h3><p>두 사람을 닮은 아이를 만들거나, 둘을 같이 나이 들게 합니다. 고객이 고를 때만 보이는 연출입니다.</p></div>
          <div class="grow__imgs">
            <figure><img loading="lazy" src="/images/ai-photobooth/grp-couple.jpg" width="560" height="835" alt="스튜디오에서 찍은 연인"><figcaption>있는 그대로</figcaption></figure>
            <span class="arrow" aria-hidden="true">→</span>
            <figure><img loading="lazy" src="/images/ai-photobooth/grp-couple-child.jpg" width="560" height="835" alt="두 사람과 두 사람을 닮은 아이"><figcaption><b>우리 아이 얼굴</b> 두 사람을 닮은 아이</figcaption></figure><figure><img loading="lazy" src="/images/ai-photobooth/grp-couple-elderly.jpg" width="560" height="835" alt="노부부가 된 두 사람"><figcaption><b>50년 뒤 우리</b> 같이 나이 든 모습</figcaption></figure>
          </div>
        </div>
      </div>
    </div>
  </section>
  
  <!-- 부스 화면 -->
  <section class="band band--violet">
    <div class="wrap">
      <div class="split split--screen">
        <div>
          <div class="head" style="margin-bottom:0">
            <span class="tag">부스 화면</span>
            <h2>BASIC과 AI,<br>화면 한 번 누르면 시작</h2>
            <p class="lead">그대로 찍는 BASIC과 연출을 입히는 AI를 첫 화면에서 고릅니다. 언어를 눌러 실제 화면을 확인해 보세요.</p>
          </div>
          <div class="langs" role="group" aria-label="화면 언어">
            <button type="button" class="lang" aria-pressed="true" data-ui="ko">한국어</button>
            <button type="button" class="lang" aria-pressed="false" data-ui="en">English</button>
            <span class="lang lang--off">日本語</span><span class="lang lang--off">Español</span>
          </div>
          <p class="note">4개 언어 기본 탑재. 이 외 희망 언어도 추가할 수 있습니다.</p>
        </div>
        <div class="screen"><img id="uiImg" src="/images/ai-photobooth/ui-ko.jpg" width="1400" height="788" alt="왼쪽은 BASIC, 오른쪽은 AI 모드를 고르는 포토부스 시작 화면. AI 쪽에는 커플 한복 견본이 보이고 아래에 언어 선택 버튼이 있다"></div>
      </div>
      <figure class="screen2"><img loading="lazy" src="/images/ai-photobooth/ui-solo.jpg" width="1400" height="802" alt="AI 쪽에 20년 뒤의 나 견본이 표시된 포토부스 시작 화면"><figcaption>AI 쪽 견본은 한복, N년 뒤의 나, 아이돌 데뷔 등으로 계속 바뀌며 고객에게 연출을 미리 보여 줍니다.</figcaption></figure>
    </div>
  </section>
  
  <!-- 커스텀 -->
  <section class="band">
    <div class="wrap split">
      <div>
        <div class="head" style="margin-bottom:0">
          <span class="tag">팝업마다, 시즌마다, 장소마다</span>
          <h2>머리부터 발끝까지,<br>원하는 모습 그대로</h2>
          <p class="lead">헤어·의상·소품·배경·공간·분위기까지 행사와 브랜드 성격에 맞춰 개발합니다. 로고 한 개가 아니라 네 가지를 함께 맞춥니다.</p>
        </div>
        <div class="four">
          <div><h3>사진 연출</h3><p>의상·배경·분위기를 컨셉에 맞춰 새로 설계합니다.</p></div>
          <div><h3>인화 틀</h3><p>로고·문구·테두리·캐릭터를 그 행사 전용으로. 4×6인치, 2×6인치 스트립.</p></div>
          <div><h3>부스 화면</h3><p>고객이 보는 안내와 문구를 행사 기간에 맞춰 바꿉니다.</p></div>
          <div><h3>QR 페이지</h3><p>휴대폰으로 사진을 받는 화면에 로고와 브랜드 색을 입힙니다.</p></div>
        </div>
      </div>
      <div class="seasons"><figure><img loading="lazy" src="/images/ai-photobooth/season-spring.jpg" width="560" height="835" alt="같은 인물의 봄 벚꽃 시즌 연출"><figcaption>봄 벚꽃</figcaption></figure><figure><img loading="lazy" src="/images/ai-photobooth/season-summer.jpg" width="560" height="835" alt="같은 인물의 여름 휴가 시즌 연출"><figcaption>여름 휴가</figcaption></figure><figure><img loading="lazy" src="/images/ai-photobooth/season-halloween.jpg" width="560" height="835" alt="같은 인물의 핼러윈 시즌 연출"><figcaption>핼러윈</figcaption></figure><figure><img loading="lazy" src="/images/ai-photobooth/season-winter.jpg" width="560" height="835" alt="같은 인물의 겨울 마켓 시즌 연출"><figcaption>겨울 마켓</figcaption></figure></div>
    </div>
  </section>
  
