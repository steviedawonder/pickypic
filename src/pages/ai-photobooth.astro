</BaseLayout>

<style>
/* Layout: 종이 바탕 위에 카드뉴스의 '라임 형광펜 라벨'을 그대로 가져온 세로 스크롤.
   보라(부스 아크릴 색)는 화면·진행 구간 한 곳에만 깊게 쓴다.
   Scoped to .ai-page so the variables and element rules never reach the site header/footer. */
.ai-page{
  color-scheme:light;
  --paper:#f3f2ee;      /* 카드뉴스 종이 바탕 */
  --sheet:#ffffff;
  --ink:#111013;
  --ink-2:#55525c;
  --rule:#d9d6cf;
  --lime:#c8ff2e;       /* 형광펜 라벨 */
  --violet:#3a1d8f;     /* 부스 아크릴 */
  --violet-deep:#1c0f45;
  --on-violet:#f1edff;
  --on-violet-2:#b9addf;
  --f-kr:"Gothic A1","Apple SD Gothic Neo","Malgun Gothic","Noto Sans KR",sans-serif;
  --f-en:"Archivo","Gothic A1","Arial Black",sans-serif;
  --gut:clamp(16px,4vw,40px);
  --max:1120px;
  --hdr:99px;           /* fixed site navbar (#navbar) height — for sticky/anchor offsets */
  background:var(--paper);color:var(--ink);font-family:var(--f-kr);font-size:16px;line-height:1.7;word-break:keep-all;-webkit-font-smoothing:antialiased
}
.ai-page p,.ai-page li,.ai-page dd{line-height:inherit}
#samples{scroll-margin-top:var(--hdr)}
.ai-page img{display:block;max-width:100%;height:auto}
.ai-page a{color:inherit}
.ai-page :focus-visible{outline:3px solid var(--violet);outline-offset:3px}
.wrap{max-width:var(--max);margin-inline:auto;padding-inline:var(--gut)}
.band{padding-block:clamp(56px,9vw,112px)}
.band--sheet{background:var(--sheet)}
.band--violet{background:var(--violet-deep);color:var(--on-violet)}
.band--violet :focus-visible{outline-color:var(--lime)}

h1,h2,h3,p{margin:0}
h1,h2{font-weight:900;letter-spacing:-.03em;line-height:1.18;text-wrap:balance}
h1{font-size:clamp(34px,6.4vw,68px)}
h2{font-size:clamp(26px,4.2vw,44px)}
h3{font-size:19px;font-weight:800;letter-spacing:-.02em;line-height:1.35}
.lead{font-size:clamp(16px,1.6vw,18px);color:var(--ink-2);max-width:34em}
.band--violet .lead{color:var(--on-violet-2)}
.head{display:grid;gap:16px;margin-bottom:clamp(28px,4vw,48px)}

/* 형광펜 라벨 — 카드뉴스의 라임 박스 */
.tag{display:inline-block;justify-self:start;background:var(--lime);color:var(--ink);border:1.5px solid var(--ink);padding:3px 10px 2px;font-weight:800;font-size:14px;letter-spacing:-.01em;line-height:1.5}
.mark{background:linear-gradient(transparent 58%,var(--lime) 58%);padding-inline:.08em}

.btns{display:flex;flex-wrap:wrap;gap:12px}
.btn{display:inline-flex;align-items:center;justify-content:center;min-height:52px;padding:0 26px;border:1.5px solid var(--ink);font-weight:800;font-size:16px;text-decoration:none;transition:transform .15s,box-shadow .15s}
.btn--main{background:var(--ink);color:var(--sheet) !important;box-shadow:5px 5px 0 var(--lime)}
.btn--ghost{background:var(--sheet)}
.btn:hover{transform:translate(-2px,-2px)}
.btn--ghost:hover{box-shadow:4px 4px 0 var(--ink)}
.btn--main:hover{box-shadow:7px 7px 0 var(--lime)}

/* HERO */
.hero{padding-block:clamp(36px,6vw,72px) clamp(48px,7vw,88px)}
.hero__grid{display:grid;grid-template-columns:1.05fr .95fr;gap:clamp(28px,5vw,64px);align-items:center}
.hero__copy{display:grid;gap:22px;min-width:0}
.hero__pic{position:relative;min-width:0}
.hero__pic img{width:100%;border:1.5px solid var(--ink)}
.hero__pic::after{content:"NEW";position:absolute;top:-14px;left:-10px;background:var(--lime);border:1.5px solid var(--ink);font-family:var(--f-en);font-stretch:112%;font-weight:800;font-size:15px;padding:4px 12px;transform:rotate(-6deg)}
.facts{display:grid;grid-template-columns:repeat(4,1fr);margin-top:clamp(36px,5vw,64px);border-top:1.5px solid var(--ink)}
.facts div{padding:18px 16px 0 0;min-width:0}
.facts b{display:block;font-family:var(--f-en);font-stretch:112%;font-weight:800;font-size:clamp(24px,3.2vw,36px);letter-spacing:-.02em;line-height:1.15}
.facts b span{font-family:var(--f-kr);font-weight:900;font-size:.62em;margin-left:2px}
.facts small{display:block;color:var(--ink-2);font-size:14px;line-height:1.5;margin-top:6px}

/* 연출 견본 */
.scenes{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,.82fr);gap:clamp(24px,4vw,56px);align-items:start}
.stage{position:relative;border:1.5px solid var(--ink);background:var(--ink)}
.stage img{width:100%;aspect-ratio:1080/1125;object-fit:cover}
.stage figcaption{position:absolute;right:10px;bottom:10px;background:var(--ink);color:var(--sheet);font-size:12px;padding:2px 8px}
.picker{display:grid;gap:0;border-top:1.5px solid var(--ink)}
.pick{all:unset;box-sizing:border-box;cursor:pointer;display:grid;grid-template-columns:auto 1fr;column-gap:14px;padding:16px 12px 16px 8px;border-bottom:1px solid var(--rule)}
.pick i{grid-row:span 2;width:14px;height:14px;margin-top:7px;border:1.5px solid var(--ink);background:var(--sheet)}
.pick strong{font-size:18px;font-weight:800;letter-spacing:-.02em}
.pick span{color:var(--ink-2);font-size:14.5px;line-height:1.55;display:none}
.pick[aria-selected="true"]{background:var(--paper)}
.pick[aria-selected="true"] i{background:var(--lime)}
.pick[aria-selected="true"] span{display:block}
.pick:hover strong{text-decoration:underline;text-underline-offset:4px}
.more{margin-top:clamp(32px,5vw,56px);display:grid;gap:14px}
.chips{display:flex;flex-wrap:wrap;gap:8px;list-style:none;margin:0;padding:0}
.chips li{border:1px solid var(--ink);padding:5px 12px 4px;font-size:14.5px;font-weight:500;background:var(--sheet)}
.chips li em{font-style:normal;color:var(--ink-2);margin-left:6px;font-size:13px}

/* 다인 촬영 */
.pairs{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:clamp(20px,3vw,40px)}
.pair{display:grid;gap:12px;margin:0}
.pair__imgs{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:10px}
.pair__imgs img{width:100%;border:1.5px solid var(--ink)}
.arrow{font-family:var(--f-en);font-weight:800;font-size:22px;background:var(--lime);border:1.5px solid var(--ink);width:34px;height:34px;display:grid;place-items:center;line-height:1}
.pair figcaption{font-size:15px;color:var(--ink-2)}
.pair figcaption b{color:var(--ink);font-weight:800}
.trio{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px;margin-top:clamp(32px,5vw,56px);padding-top:24px;border-top:1.5px solid var(--ink)}
.trio p{font-size:15px;color:var(--ink-2);margin-top:6px}

/* 부스 화면 (보라) */
.split{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,.9fr);gap:clamp(28px,5vw,64px);align-items:center}
.screen{border:8px solid var(--violet);box-shadow:0 0 0 1.5px var(--on-violet-2)}
.screen img{width:100%}
.langs{display:flex;flex-wrap:wrap;gap:8px;list-style:none;padding:0;margin:20px 0 0}
.langs li{border:1px solid var(--on-violet-2);border-radius:99px;padding:4px 14px 3px;font-size:14px}
.langs li:first-child{background:var(--lime);color:var(--ink);border-color:var(--lime);font-weight:800}
.note{font-size:13.5px;color:var(--on-violet-2);margin-top:10px}

/* 커스텀 */
.four{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0;border-top:1.5px solid var(--ink);margin-top:28px}
.four div{padding:18px 18px 18px 0;border-bottom:1px solid var(--rule)}
.four p{font-size:15px;color:var(--ink-2);margin-top:4px}
.collage{border:1.5px solid var(--ink);background:var(--paper)}

/* 행사 유형 */
.uses{border-top:1.5px solid var(--ink)}
.use{display:grid;grid-template-columns:minmax(120px,200px) 1fr;gap:8px 32px;padding:18px 0;border-bottom:1px solid var(--rule);align-items:baseline}
.use dt{font-weight:800;font-size:18px;letter-spacing:-.02em}
.use dd{margin:0;color:var(--ink-2)}
dl{margin:0}

/* 진행 */
.steps{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:0;border-top:1.5px solid var(--on-violet-2)}
.steps li{padding:20px 18px 0 0;min-width:0}
.steps .when{font-family:var(--f-en);font-stretch:112%;font-weight:800;color:var(--lime);font-size:15px;letter-spacing:.02em}
.steps h3{margin:6px 0 8px;font-size:20px}
.steps p{font-size:14.5px;color:var(--on-violet-2);line-height:1.6}
.steps .ok{display:inline-block;margin-top:10px;background:var(--lime);color:var(--ink);font-size:12.5px;font-weight:800;padding:1px 8px}

/* 개인정보 */
.care{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:24px}
.care div{border-top:1.5px solid var(--ink);padding-top:16px}
.care p{font-size:15px;color:var(--ink-2);margin-top:6px}

/* FAQ */
.faq{border-top:1.5px solid var(--ink);max-width:820px}
.faq details{border-bottom:1px solid var(--rule)}
.faq summary{cursor:pointer;list-style:none;display:flex;justify-content:space-between;gap:16px;padding:18px 4px;font-weight:800;font-size:17px;letter-spacing:-.02em}
.faq summary::-webkit-details-marker{display:none}
.faq summary::after{content:"+";font-family:var(--f-en);font-size:22px;line-height:1.1}
.faq details[open] summary::after{content:"–"}
.faq p{padding:0 4px 20px;color:var(--ink-2);max-width:40em}

/* CTA */
.cta{background:var(--lime);border-block:1.5px solid var(--ink);padding-block:clamp(48px,7vw,88px)}
.cta__in{display:grid;grid-template-columns:1.2fr .8fr;gap:32px;align-items:end}
.cta .btn--main{box-shadow:5px 5px 0 var(--sheet)}
.cta .btn--main:hover{box-shadow:7px 7px 0 var(--sheet)}
.contact{font-size:15px;display:grid;gap:4px}
.contact b{font-family:var(--f-en);font-stretch:112%;font-size:24px;font-weight:800;user-select:all}
.fine{font-size:12.5px;color:var(--ink-2);padding-block:20px}

@media (max-width:860px){
  .hero__grid,.scenes,.split,.cta__in{grid-template-columns:minmax(0,1fr)}
  .hero__pic{order:-1}
  .facts{grid-template-columns:repeat(2,1fr);row-gap:8px}
  .pairs{grid-template-columns:minmax(0,1fr)}
  .trio{grid-template-columns:minmax(0,1fr)}
  .steps{grid-template-columns:minmax(0,1fr);border-top:0}
  .steps li{border-top:1px solid var(--on-violet-2);padding:18px 0}
  .care{grid-template-columns:repeat(2,minmax(0,1fr))}
  .use{grid-template-columns:minmax(0,1fr)}
}
@media (max-width:480px){
  .four,.care{grid-template-columns:minmax(0,1fr)}
  .btn{flex:1 1 100%}
}
@media (prefers-reduced-motion:reduce){.btn{transition:none}}

/* 촬영본 인셋 */
.stage img#stageImg{aspect-ratio:1000/1241}
.inset{position:absolute;left:4%;top:3.5%;width:34%;border:1.5px solid var(--ink);background:var(--sheet);display:block}
.inset img{width:100%;aspect-ratio:420/521;object-fit:cover}
.inset em{position:absolute;right:6px;bottom:5px;font-style:normal;font-size:12px;color:var(--sheet);text-shadow:0 0 4px rgba(0,0,0,.6)}
/* 원본 한 장 */
.one{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,3.1fr);gap:clamp(20px,3vw,40px);align-items:start}
.one figure,.grow figure,.seasons figure,.screen2{margin:0}
.one__src{position:sticky;top:calc(var(--hdr) + 16px)}
.one__src img{width:100%;border:1.5px solid var(--ink)}
.one__src figcaption{margin-top:-14px;margin-left:10px;position:relative}
.one__grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:22px 14px}
.one__grid img,.grow img,.seasons img{width:100%;border:1px solid var(--ink)}
.one__grid figcaption,.grow figcaption,.seasons figcaption{font-size:13px;color:var(--ink-2);line-height:1.45;margin-top:8px}
.one__grid figcaption b,.grow figcaption b{display:block;color:var(--ink);font-size:15px;font-weight:800;letter-spacing:-.02em}
/* 다인 */
.grows{display:grid;border-top:1.5px solid var(--ink)}
.grow{display:grid;grid-template-columns:minmax(0,.7fr) minmax(0,2fr);gap:clamp(16px,3vw,40px);padding-block:clamp(24px,3vw,36px);border-bottom:1px solid var(--rule);align-items:start}
.grow__txt p{font-size:15px;color:var(--ink-2);margin-top:8px;max-width:22em}
.grow__imgs{display:grid;grid-template-columns:minmax(0,1fr) auto minmax(0,1fr) minmax(0,1fr);gap:12px;align-items:start}
.grow__imgs .arrow{align-self:center;margin-bottom:40px;width:30px;height:30px;font-size:18px}
/* 화면 */
.split--screen{grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr)}
.langs{display:flex;flex-wrap:wrap;gap:8px;margin-top:20px}
.lang{all:unset;box-sizing:border-box;border:1px solid var(--on-violet-2);border-radius:99px;padding:5px 16px 4px;font-size:14px;color:var(--on-violet)}
button.lang{cursor:pointer}
button.lang[aria-pressed="true"]{background:var(--lime);color:var(--ink);border-color:var(--lime);font-weight:800}
button.lang:focus-visible{outline:3px solid var(--lime);outline-offset:3px}
.lang--off{opacity:.55}
.screen2{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.4fr);gap:clamp(20px,4vw,48px);align-items:center;margin-top:clamp(32px,5vw,56px);padding-top:clamp(24px,4vw,40px);border-top:1px solid var(--violet)}
.screen2 img{width:100%;border:6px solid var(--violet);order:2}
.screen2 figcaption{color:var(--on-violet-2);font-size:15px;max-width:26em}
/* 시즌 */
.seasons{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}
@media (max-width:860px){
  .one{grid-template-columns:minmax(0,1fr)}
  .one__src{position:static;max-width:220px}
  .one__grid{grid-template-columns:repeat(3,minmax(0,1fr))}
  .grow,.screen2,.split--screen{grid-template-columns:minmax(0,1fr)}
  .seasons{grid-template-columns:repeat(4,minmax(0,1fr))}
}
@media (max-width:480px){
  .one__grid{grid-template-columns:repeat(2,minmax(0,1fr))}
  .seasons{grid-template-columns:repeat(2,minmax(0,1fr))}
