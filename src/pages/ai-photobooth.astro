  .grow__imgs .arrow{width:22px;height:22px;font-size:13px}
}

.hero__pic{padding-bottom:9%;padding-left:9%}
.hero__pic .hero__main{width:100%}
.hero__pic .hero__sub{position:absolute;left:0;bottom:0;width:44%;border:1.5px solid var(--ink);box-shadow:6px 6px 0 var(--lime)}
.hero__pic::after{left:auto;right:-10px;transform:rotate(6deg)}

</style>

<script>
  const IMG = '/images/ai-photobooth/';

  const stageImg = document.getElementById('stageImg') as HTMLImageElement | null;
  const stageBefore = document.getElementById('stageBefore') as HTMLImageElement | null;
  const picks = Array.from(document.querySelectorAll<HTMLButtonElement>('.ai-page .pick'));
  picks.forEach((b) => {
    b.setAttribute('tabindex', '0');
    const go = () => {
      picks.forEach((p) => p.setAttribute('aria-selected', p === b ? 'true' : 'false'));
      const name = b.dataset.img || '';
      if (stageImg) {
        stageImg.src = `${IMG}${name}.jpg`;
        stageImg.alt = b.dataset.alt || '';
      }
      if (stageBefore) stageBefore.src = `${IMG}${name.replace('scene-', 'before-')}.jpg`;
    };
    b.addEventListener('click', go);
    b.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        go();
      }
    });
  });

  const uiImg = document.getElementById('uiImg') as HTMLImageElement | null;
  const langs = Array.from(document.querySelectorAll<HTMLButtonElement>('.ai-page button.lang'));
  langs.forEach((b) => {
    b.addEventListener('click', () => {
      langs.forEach((x) => x.setAttribute('aria-pressed', x === b ? 'true' : 'false'));
      if (uiImg) uiImg.src = `${IMG}ui-${b.dataset.ui}.jpg`;
    });
  });
</script>
