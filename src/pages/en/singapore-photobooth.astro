---
// SEO Landing Page: Photo Booth Rental Singapore
// Target keywords: Singapore photobooth rental, photo booth rental Singapore, photobooth Singapore, event photo booth Singapore
// This page is English-only for international/Singapore market

import BaseLayout from '@layouts/BaseLayout.astro';
import BreadcrumbSchema from '@components/seo/BreadcrumbSchema.astro';
import ServiceSchema from '@components/seo/ServiceSchema.astro';
import FAQSchema from '@components/seo/FAQSchema.astro';
import ProofBand from '@components/en/ProofBand.astro';
import LogoWall from '@components/en/LogoWall.astro';
import { products } from '@data/products';

const nameToId: Record<string, string> = {
  'Modern Picky': 'modern-picky', 'Classic Picky': 'classic-picky', 'Urban Picky': 'urban-picky',
  'Modern Mini Picky': 'modern-mini-picky', 'Urban Mini Picky': 'urban-mini-picky',
  'Modern Retro Picky': 'modern-retro-picky', 'Urban Retro Picky': 'urban-retro-picky',
  'Outdoor Picky': 'outdoor-picky', 'Air Picky': 'air-picky',
};

const faqItems = [
  {
    question: 'How much does it cost to rent a photo booth in Singapore?',
    // No figures here: Kickstarter does not allow a product that is already on
    // sale, and they check the company site. This answer feeds FAQPage schema,
    // so a number would also surface as a rich result.
    answer: 'Pricing depends on the photo booth model, event duration, and how much customization you need. Tell us about your event and we will send a detailed quote.',
  },
  {
    question: 'Do you deliver and set up photo booths in Singapore?',
    answer: 'Yes! PICKYPIC provides full end-to-end service in Singapore including delivery, professional setup, on-site operation during your event, and teardown. Our team handles everything so you can focus on your event.',
  },
  {
    question: 'How far in advance should I book a photo booth?',
    answer: 'We recommend booking at least 2-4 weeks in advance for standard events. For large-scale corporate events or brand activations, we suggest reaching out 4-8 weeks ahead to ensure availability and allow time for custom branding.',
  },
  {
    question: 'Can I customize the photo booth design and photo templates?',
    answer: 'Absolutely! We offer full brand customization including custom photo frame designs, booth wrapping with your brand colors and logos, custom start screens, and branded print layouts. Our design team works with you to create a cohesive brand experience.',
  },
  {
    question: 'What types of events are your photo booths suitable for?',
    answer: 'Our photo booths are perfect for corporate events, brand pop-ups, product launches, weddings, birthday parties, gala dinners, trade shows, and festivals. We have served clients like Netflix, Hyundai, Starbucks, and New Balance across various event types.',
  },
  {
    question: 'Do your photo booths support instant printing and digital sharing?',
    answer: 'Yes, all our photo booths come equipped with high-quality instant printing (4x6 or strip format). Guests can also receive digital copies via QR code, email, or Airdrop for easy sharing on social media.',
  },
];

// Photo booth model data
const boothModels = {
  stand: [
    { name: 'Modern Picky', desc: 'Sleek, minimalist standing photo booth with a premium finish. Ideal for brand pop-ups and corporate events.' },
    { name: 'Classic Picky', desc: 'Timeless design with warm tones. Perfect for weddings, galas, and elegant gatherings.' },
    { name: 'Urban Picky', desc: 'Bold, industrial-inspired design. Great for trendy events, festivals, and youth-oriented activations.' },
  ],
  table: [
    { name: 'Modern Mini Picky', desc: 'Compact tabletop booth with modern aesthetics. Fits small venues and intimate events.' },
    { name: 'Urban Mini Picky', desc: 'Edgy tabletop design for casual and creative event spaces.' },
    { name: 'Modern Retro Picky', desc: 'Receipt-style photo prints with a nostalgic twist. A guest favorite for unique keepsakes.' },
    { name: 'Urban Retro Picky', desc: 'Urban-styled receipt photo booth combining retro charm with contemporary design.' },
  ],
  booth: [
    { name: 'Outdoor Picky', desc: 'Weather-ready enclosed booth for outdoor festivals, rooftop parties, and open-air events.' },
    { name: 'Air Picky', desc: 'Inflatable photo booth with striking visual presence. Perfect for large-scale activations and exhibitions.' },
  ],
};

const processSteps = [
  { step: '01', title: 'Inquiry', desc: 'Tell us about your event — date, venue, guest count, and any branding needs.' },
  { step: '02', title: 'Quote', desc: 'We provide a detailed proposal with booth recommendations, pricing, and customization options.' },
  { step: '03', title: 'Setup', desc: 'Our team arrives early to deliver, install, and test the photo booth at your venue.' },
  { step: '04', title: 'Event', desc: 'Sit back and enjoy. Our on-site staff operates the booth and assists your guests throughout.' },
  { step: '05', title: 'Teardown', desc: 'After the event, we handle complete teardown and removal — no hassle for you.' },
];

// Reasons kept as prose. The figures that used to head these four cards (9+,
// 16,000+, 100%, ∞) are gone — ProofBand carries the countable ones instead.
const reasons = [
  { title: 'Photo Booth Models', desc: 'Stand, table, and booth types — the widest selection of Korean-designed photo booths available in Singapore.' },
  { title: 'Events Served', desc: 'Trusted by global brands like Netflix, Hyundai, Kia, New Balance, and Starbucks for premium activations.' },
  { title: 'Full-Service', desc: 'End-to-end service from delivery and setup to on-site operation and teardown. We handle everything.' },
  { title: 'Custom Branding', desc: 'Full customization of booth wraps, photo templates, start screens, and print layouts to match your brand.' },
];

const services = [
  {
    image: '/images/rental/rental-2.jpg',
    alt: 'PICKYPIC photo booth at a corporate event',
    title: 'Corporate Events',
    desc: 'Company D&Ds, annual dinners, team-building events, product launches, and conferences with branded photo experiences.',
  },
  {
    image: '/images/rental/rental-3.jpg',
    alt: 'PICKYPIC photo booth at a brand pop-up',
    title: 'Brand Pop-ups',
    desc: 'Retail activations, pop-up stores, and brand experience zones with fully customized booth wrapping and photo templates.',
  },
  {
    image: '/images/rental/rental-4.jpg',
    alt: 'PICKYPIC photo booth at a wedding reception',
    title: 'Weddings',
    desc: 'Elegant photo booth setups for wedding receptions, solemnizations, and pre-wedding events. Create lasting memories for your guests.',
  },
  {
    image: '/images/rental/rental-6.jpg',
    alt: 'PICKYPIC photo booth at a private party',
    title: 'Parties & Celebrations',
    desc: 'Birthday parties, graduation celebrations, festive gatherings, and private events with fun, interactive photo booth experiences.',
  },
];

const customization = [
  { title: 'Booth Wrapping', desc: 'Full exterior wrapping with your brand colors, logos, and campaign artwork for maximum visual impact.' },
  { title: 'Photo Frame Design', desc: 'Custom photo frame templates with your brand elements, event name, date, and hashtags printed on every photo.' },
  { title: 'Start Screen UI', desc: 'Branded welcome screen with your logo, event message, and custom animations displayed before each photo session.' },
  { title: 'Print Layouts', desc: 'Choose from strip photos, 4-cut grids, or single prints — all fully customizable with your branding.' },
  { title: 'Digital Sharing', desc: 'QR code sharing, email delivery, and Airdrop support so guests can instantly post their photos to social media.' },
  { title: 'Filter & Effects', desc: 'Custom photo filters, color grading presets, and AR effects tailored to your brand aesthetic and campaign theme.' },
];

const modelGroups = [
  { label: 'Stand Type', items: boothModels.stand, cols: 'md:grid-cols-3' },
  { label: 'Table Type', items: boothModels.table, cols: 'md:grid-cols-2 lg:grid-cols-4' },
  { label: 'Booth Type', items: boothModels.booth, cols: 'md:grid-cols-2' },
];
---

<BaseLayout
  title="Photo Booth Rental Singapore | PICKYPIC Photobooth"
  description="Premium photo booth rental in Singapore for corporate events, brand pop-ups, weddings & parties. 9+ booth models, full brand customization, instant prints. Get a free quote from PICKYPIC."
>
  <!-- Structured Data -->
  <BreadcrumbSchema items={[
    { name: 'Home', href: '/en/' },
    { name: 'Photo Booth Rental Singapore', href: '/en/singapore-photobooth' },
  ]} />
  <ServiceSchema
    serviceName="Photo Booth Rental Singapore"
    serviceType="Photo Booth Rental"
    description="Premium photo booth rental service in Singapore by PICKYPIC. Offering 9+ Korean-designed photo booth models for corporate events, brand pop-ups, weddings, and parties with full customization and on-site support."
  />

  <!-- Hero -->
  {/* The visual breadcrumb above already carries pt-18 (4.5rem) to clear the
      fixed navbar, so pt-28 here would stack to ~11rem of dead space. pt-8
      lands the H1 at roughly the same 7rem from the top of the viewport. */}
  <section class="bg-white pt-8 pb-16 lg:pt-12 lg:pb-24">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-center">
        <div>
          <p class="text-[11px] font-semibold uppercase tracking-[0.4em] text-secondary">Singapore</p>
          <div class="accent-line mt-4 mb-6"></div>
          <h1 class="font-display font-bold text-[clamp(2rem,5vw,3.75rem)] leading-[1.05] tracking-tight text-primary">
            Photo Booth Rental Singapore
          </h1>
          <p class="mt-6 text-sm lg:text-base text-secondary leading-relaxed">
            PICKYPIC Photobooth is a premium photo booth rental company headquartered in Seoul, South Korea, with operations in Singapore. With a lineup of 9+ photo booth models and experience serving over 16,000 brand events including Netflix, Hyundai, and Starbucks, PICKYPIC brings Korean-designed modern photo booth experiences to Singapore.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="/en/#contact" class="inline-flex items-center px-7 py-3 bg-primary text-white text-sm font-semibold rounded-full hover:opacity-90 transition-opacity">
              Get a Free Quote
            </a>
            <a href="https://www.instagram.com/pickypic.sg/" target="_blank" rel="noopener noreferrer" class="inline-flex items-center px-7 py-3 border border-primary text-primary text-sm font-semibold rounded-full hover:bg-primary hover:text-white transition-colors">
              @pickypic.sg
              <svg class="ml-2 w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
            </a>
          </div>
        </div>
        <img
          src="/images/rental/rental-1.jpg"
          alt="PICKYPIC photo booth set up at a brand event"
          width="1200"
          height="900"
          fetchpriority="high"
          decoding="async"
          class="w-full aspect-[4/3] object-cover"
        />
      </div>
    </div>
  </section>

  <ProofBand />

  <LogoWall />

  <!-- Why Choose PICKYPIC Singapore -->
  <section class="bg-bg-light py-20 lg:py-28">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <h2 class="font-display font-bold text-[clamp(1.5rem,2.5vw,2.25rem)] tracking-tight text-primary mb-12">
        Why Choose PICKYPIC Singapore
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-px bg-border border-t border-border gs-stagger">
        {reasons.map((r) => (
          <div class="bg-bg-light p-6">
            <h3 class="font-semibold text-primary mb-2">{r.title}</h3>
            <p class="text-sm text-secondary leading-relaxed">{r.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Our Photo Booth Models -->
  <section class="bg-white py-20 lg:py-28">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <h2 class="font-display font-bold text-[clamp(1.5rem,2.5vw,2.25rem)] tracking-tight text-primary mb-4">
        Our Photo Booth Models
      </h2>
      <p class="text-secondary text-sm lg:text-base leading-relaxed max-w-2xl mb-12">
        Choose from our diverse lineup of Korean-designed photo booths for your Singapore event.
      </p>

      <div class="space-y-12 gs-fade-up">
        {modelGroups.map((group) => (
          <div>
            <h3 class="text-[11px] font-semibold uppercase tracking-[0.4em] text-secondary mb-4">{group.label}</h3>
            <div class:list={['grid grid-cols-1 gap-px bg-border-light border-t border-border-light', group.cols]}>
              {group.items.map((model) => (
                <button
                  type="button"
                  class="product-row bg-white text-left p-6 flex items-center gap-5 hover:bg-accent-tint transition-colors cursor-pointer"
                  data-product-id={nameToId[model.name]}
                >
                  <img
                    src={`/images/en/line/${nameToId[model.name] === "classic-picky" ? "modern-picky" : nameToId[model.name]}.webp`}
                    alt={model.name}
                    width="120"
                    height="180"
                    loading="lazy"
                    decoding="async"
                    class="w-14 lg:w-16 h-auto shrink-0 object-contain"
                  />
                  <span class="block">
                    <span class="block font-semibold text-primary mb-2">{model.name}</span>
                    <span class="block text-sm text-secondary leading-relaxed">{model.desc}</span>
                  </span>
                </button>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Services -->
  <section class="bg-bg-light py-20 lg:py-28">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <h2 class="font-display font-bold text-[clamp(1.5rem,2.5vw,2.25rem)] tracking-tight text-primary mb-12">
        Photo Booth Services in Singapore
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 gs-stagger">
        {services.map((s) => (
          <div>
            <img
              src={s.image}
              alt={s.alt}
              width="800"
              height="600"
              loading="lazy"
              decoding="async"
              class="w-full aspect-[4/3] object-cover mb-5"
            />
            <h3 class="font-semibold text-primary mb-2">{s.title}</h3>
            <p class="text-sm text-secondary leading-relaxed">{s.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- How It Works -->
  <section class="bg-white py-20 lg:py-28">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <h2 class="font-display font-bold text-[clamp(1.5rem,2.5vw,2.25rem)] tracking-tight text-primary mb-12">
        How It Works
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-5 gap-8 lg:gap-6 gs-stagger">
        {processSteps.map((item) => (
          <div class="border-t border-border pt-5">
            <p class="font-stencil text-[2.5rem] leading-none text-border">{item.step}</p>
            <h3 class="font-semibold text-primary mt-3 mb-2">{item.title}</h3>
            <p class="text-sm text-secondary leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Full-bleed installation photo -->
  <section class="gs-fade-in">
    <img
      src="/images/rental/rental-8.jpg"
      alt="A PICKYPIC photo booth installed and running at an event venue"
      width="1600"
      height="686"
      loading="lazy"
      decoding="async"
      class="w-full aspect-[4/3] sm:aspect-[21/9] object-cover"
    />
  </section>

  <!-- Brand Customization Options -->
  <section class="bg-bg-light py-20 lg:py-28">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <h2 class="font-display font-bold text-[clamp(1.5rem,2.5vw,2.25rem)] tracking-tight text-primary mb-4">
        Brand Customization Options
      </h2>
      <p class="text-secondary text-sm lg:text-base leading-relaxed max-w-2xl mb-12">
        Make the photo booth truly yours. Every element can be tailored to align with your brand identity and event theme.
      </p>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-px bg-border border-t border-border gs-stagger">
        {customization.map((c) => (
          <div class="bg-bg-light p-6">
            <h3 class="font-semibold text-primary mb-2">{c.title}</h3>
            <p class="text-sm text-secondary leading-relaxed">{c.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <FAQSchema items={faqItems} title="Frequently Asked Questions" />

  <!-- Final CTA -->
  <section class="section-dark py-20 lg:py-28">
    <div class="mx-auto max-w-7xl px-6 lg:px-8 gs-fade-up">
      <h2 class="font-display font-bold text-[clamp(1.5rem,2.5vw,2.25rem)] tracking-tight text-white mb-4">
        Ready to Book a Photo Booth in Singapore?
      </h2>
      <p class="text-white/70 text-sm lg:text-base leading-relaxed max-w-2xl mb-8">
        Whether it's a corporate event, brand activation, wedding, or party — PICKYPIC delivers premium photo booth experiences to Singapore. Get in touch today for a free quote.
      </p>
      <div class="flex flex-wrap gap-3">
        <a href="/en/#contact" class="inline-flex items-center px-7 py-3 bg-white text-primary text-sm font-semibold rounded-full hover:opacity-90 transition-opacity">
          Get a Free Quote
        </a>
        <a href="https://www.instagram.com/pickypic.sg/" target="_blank" rel="noopener noreferrer" class="inline-flex items-center px-7 py-3 border border-white/40 text-white text-sm font-semibold rounded-full hover:bg-white hover:text-primary transition-colors">
          Follow @pickypic.sg
        </a>
      </div>
    </div>
  </section>

  <!-- Product Spec Modal -->
  <div id="product-modal" class="fixed inset-0 z-50 hidden" role="dialog" aria-modal="true" aria-label="Product details">
    <div id="modal-backdrop" class="absolute inset-0 bg-black/60"></div>
    <div class="absolute inset-0 flex items-center justify-center p-4 sm:p-6">
      <div class="relative bg-white border border-border w-full max-w-5xl max-h-[90vh] overflow-y-auto">
        <button type="button" id="modal-close" class="absolute top-4 right-4 z-10 w-10 h-10 flex items-center justify-center border border-border bg-white hover:bg-primary hover:text-white hover:border-primary transition-colors cursor-pointer" aria-label="Close">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
        </button>
        <div class="pt-8 pb-4 px-8 border-b border-border-light">
          <span id="modal-type" class="block mb-1 text-[11px] font-semibold uppercase tracking-[0.4em] text-secondary"></span>
          <h3 id="modal-name" class="font-display font-bold text-[clamp(1.25rem,2.5vw,1.75rem)] tracking-tight text-primary"></h3>
        </div>
        <div class="hidden lg:grid lg:grid-cols-12 gap-0 p-8 items-center">
          <div class="lg:col-span-3 flex items-center justify-center"><img id="modal-img-left" src="" alt="" class="max-w-full max-h-[420px]" /></div>
          <div class="lg:col-span-6 px-6 flex flex-col justify-center">
            <h4 class="text-[11px] font-semibold uppercase tracking-[0.4em] text-secondary mb-4">Photo booth specification</h4>
            <table class="w-full text-sm border-collapse"><tbody id="modal-specs-desktop"></tbody></table>
          </div>
          <div class="lg:col-span-3 flex items-center justify-center"><img id="modal-img-right" src="" alt="" class="max-w-full max-h-[420px]" /></div>
        </div>
        <div class="lg:hidden p-6">
          <div class="flex gap-4 justify-center mb-6 items-center">
            <div class="w-1/2 max-w-[180px] flex items-center justify-center"><img id="modal-img-left-m" src="" alt="" class="max-w-full max-h-[260px] object-contain" /></div>
            <div class="w-1/2 max-w-[180px] flex items-center justify-center"><img id="modal-img-right-m" src="" alt="" class="max-w-full max-h-[260px] object-contain" /></div>
          </div>
          <h4 class="text-[11px] font-semibold uppercase tracking-[0.4em] text-secondary mb-4">Photo booth specification</h4>
          <table class="w-full text-sm border-collapse"><tbody id="modal-specs-mobile"></tbody></table>
        </div>
        <div class="px-8 pb-8 flex flex-wrap gap-3">
          <a href="/en/" class="inline-flex items-center justify-center px-6 py-3 bg-primary text-white font-semibold text-sm rounded-full hover:opacity-90 transition-opacity">View All Products</a>
          <a href="/en/#contact" class="inline-flex items-center justify-center px-6 py-3 border border-primary text-primary font-semibold text-sm rounded-full hover:bg-primary hover:text-white transition-colors">Rental Inquiry</a>
        </div>
      </div>
    </div>
  </div>
  <script id="products-data" type="application/json" set:html={JSON.stringify(
    // imageLeft points at the source *-line.png, which is a full spec sheet:
    // drawing, dimension callouts, a Korean model name and a "Wood Color" chip
    // block. Serve the cropped product-only derivative on /en/ instead — the
    // originals stay untouched for /support/[slug].
    products.map(p => ({
      id: p.id,
      name: p.name,
      type: p.type,
      imageLeft: `/images/en/line/${p.id === 'classic-picky' ? 'modern-picky' : p.id}.webp`,
      imageRight: p.imageRight,
      specs: p.specs,
    }))
  )} />
</BaseLayout>

<script>
  function initProductModal() {
    const modal = document.getElementById('product-modal');
    const backdrop = document.getElementById('modal-backdrop');
    const closeBtn = document.getElementById('modal-close');
    if (!modal || !backdrop || !closeBtn) return;
    const productsData = JSON.parse(document.getElementById('products-data')?.textContent || '[]');
    const productById: Record<string, any> = {};
    productsData.forEach((p: any) => { productById[p.id] = p; });
    const smallTypes = ['modern-mini-picky', 'urban-mini-picky', 'modern-retro-picky', 'urban-retro-picky'];
    function openModal(productId: string) {
      const product = productById[productId];
      if (!product) return;
      const maxH = smallTypes.includes(productId) ? 'max-h-[320px]' : 'max-h-[420px]';
      (document.getElementById('modal-type') as HTMLElement).textContent = product.type;
      (document.getElementById('modal-name') as HTMLElement).textContent = product.name;
      const imgLeft = document.getElementById('modal-img-left') as HTMLImageElement;
      const imgRight = document.getElementById('modal-img-right') as HTMLImageElement;
      imgLeft.src = product.imageLeft; imgLeft.alt = product.name; imgLeft.className = `max-w-full ${maxH}`;
      imgRight.src = product.imageRight; imgRight.alt = product.name; imgRight.className = `max-w-full ${maxH}`;
      const imgLeftM = document.getElementById('modal-img-left-m') as HTMLImageElement;
      const imgRightM = document.getElementById('modal-img-right-m') as HTMLImageElement;
      imgLeftM.src = product.imageLeft; imgLeftM.alt = imgLeft.alt;
      imgRightM.src = product.imageRight; imgRightM.alt = imgRight.alt;
      const specHtml = product.specs.map((s: any) =>
        `<tr class="border-b border-border-light"><th class="text-left py-2 pr-4 font-semibold text-primary text-xs whitespace-nowrap align-top w-[140px]">${s.label}</th><td class="py-2 text-secondary text-xs leading-relaxed">${s.value}</td></tr>`
      ).join('');
      (document.getElementById('modal-specs-desktop') as HTMLElement).innerHTML = specHtml;
      (document.getElementById('modal-specs-mobile') as HTMLElement).innerHTML = specHtml;
      modal.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }
    function closeModal() {
      modal.classList.add('hidden');
      document.body.style.overflow = '';
    }
    document.querySelectorAll<HTMLElement>('.product-row').forEach(el => {
      el.addEventListener('click', () => { const id = el.dataset.productId; if (id) openModal(id); });
    });
    closeBtn.addEventListener('click', closeModal);
    backdrop.addEventListener('click', closeModal);
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !modal.classList.contains('hidden')) closeModal(); });
  }

  document.addEventListener('DOMContentLoaded', () => { initProductModal(); });
  document.addEventListener('astro:after-swap', () => { initProductModal(); });
</script>
