---
import { company } from '@data/company';
import { serverT } from '../../i18n/serverT';
import { sanityClient } from '../../sanity/client';

// Resolve chrome labels at build time so /en/ ships English in the markup
// itself; the data-i18n attributes stay for the client ko -> jp switch.
const t = serverT(Astro.url.pathname);

// Fetch footer data from Sanity siteSettings at build time
let footerData: any = null;
try {
  footerData = await sanityClient.fetch(`*[_type == "siteSettings"][0] {
    companyName, businessNumber, address, phone, email, partnerEmail,
    kakaoChannel, kakaoUrl, instagramOfficial, instagramGlobal, instagramSg, naverStoreUrl
  }`);
} catch (e) {
  // Fallback to company.ts data
}

// These links all point at Korean pages, so on /en/ they would dump an English
// visitor onto content they cannot read — the same failure the main nav avoids.
// Add entries as English pages ship.
const isEn = Astro.url.pathname.startsWith('/en');
const serviceLinks = isEn
  ? [
      { href: '/en/', label: 'Home' },
      { href: '/en/kickstarter', label: 'Kickstarter' },
      { href: '/en/singapore-photobooth', label: 'Singapore Photobooth' },
    ]
  : [
      { href: '/products', label: '제품소개', i18n: 'footer.link.products' },
      { href: '/rental', label: '렌탈문의', i18n: 'footer.link.rental' },
      { href: '/photobooth-rental', label: '포토부스 렌탈', i18n: 'footer.link.photobooth_rental' },
      { href: '/photobooth-purchase', label: '포토부스 구매', i18n: 'footer.link.photobooth_purchase' },
      { href: '/corporate-event', label: '기업행사 포토부스', i18n: 'footer.link.corporate_event' },
      { href: '/popup-photobooth', label: '팝업 포토부스', i18n: 'footer.link.popup_photobooth' },
      { href: '/retro-photobooth', label: '레트로 포토부스', i18n: 'footer.link.retro_photobooth' },
      { href: '/photobooth-startup', label: '포토부스 창업', i18n: 'footer.link.photobooth_startup' },
      { href: '/en/singapore-photobooth', label: 'Singapore Photobooth', i18n: 'footer.link.singapore' },
      { href: '/portfolio', label: '포트폴리오', i18n: 'footer.link.portfolio' },
    ];

// Use Sanity data if available, otherwise fallback to company.ts
const footer = {
  name: isEn ? company.nameEn : (footerData?.companyName || company.name),
  businessNumber: footerData?.businessNumber || company.businessNumber,
  address: isEn ? company.addressEn : (footerData?.address || company.address),
  phone: footerData?.phone || company.phone,
  phoneTel: `tel:${(footerData?.phone || company.phone).replace(/[^0-9+]/g, '')}`,
  email: footerData?.email || company.email,
  partnerEmail: footerData?.partnerEmail || company.partnerEmail,
  kakaoChannel: footerData?.kakaoChannel || company.kakaoChannel,
  kakaoUrl: footerData?.kakaoUrl || company.kakaoUrl,
  instagram: {
    official: company.instagram.official,
    global: company.instagram.global,
    sg: company.instagram.sg,
  },
};
---

<footer class="text-white relative z-10" style="background-color: #262626;">
  <div class="mx-auto max-w-7xl px-6 py-8 lg:px-8 lg:py-16">
    <!-- Logo & Company Info -->
    <div class="lg:grid lg:grid-cols-3 lg:gap-10">
      <div>
        <img
          src="/images/common/footer-logo.png"
          alt={isEn
            ? 'PICKYPIC PHOTOBOOTH — handmade photo booths from Seoul, Korea'
            : '피키픽 포토부스 — 포토부스 대여 및 렌탈 전문 PICKYPIC PHOTOBOOTH®'}
          class="h-6 lg:h-8 mb-4 lg:mb-6"
        />
        <address class="not-italic text-xs lg:text-sm text-white/60 leading-relaxed space-y-0.5 lg:space-y-1">
          <p><span data-i18n="footer.company_label">{t("footer.company_label")}</span> : <a href="/admin" style="color: inherit; text-decoration: none;">{footer.name}</a></p>
          <p><span data-i18n="footer.business_number">{t("footer.business_number")}</span> : {footer.businessNumber}</p>
          <p><span data-i18n="footer.address_label">{t("footer.address_label")}</span> : {footer.address}</p>
          <p><span data-i18n="footer.phone_label">{t("footer.phone_label")}</span> : <a href={footer.phoneTel} class="hover:text-white/80 transition-colors">{footer.phone}</a></p>
        </address>
        <p class="mt-3 lg:mt-6 text-[10px] lg:text-xs text-white/30">
          &copy; {new Date().getFullYear()} Picky Global Ltd. All rights reserved.
        </p>
      </div>

      <!-- Follow us & Contact us -->
      <div class="grid grid-cols-2 gap-4 mt-6 lg:mt-0 lg:col-span-2 lg:grid-cols-2 lg:justify-items-end">
        <!-- Follow us -->
        <div>
          <h3 class="text-xs lg:text-sm font-semibold tracking-wide mb-2 lg:mb-4">Follow us</h3>
          <div class="space-y-1 lg:space-y-2 text-xs lg:text-sm text-white/60 leading-relaxed">
            {/* KakaoTalk is a Korean messenger and the channel handle is Hangul —
                it is noise on /en/, where email and the quote form are the path. */}
            {!isEn && (
              <p><span data-i18n="footer.kakao">카카오톡 채널</span> <a href={footer.kakaoUrl} target="_blank" rel="noopener noreferrer" class="hover:text-white/80 transition-colors">{footer.kakaoChannel}</a></p>
            )}
            <div>
              <p>Instagram  <a href={`https://www.instagram.com/${footer.instagram.official}/`} target="_blank" rel="noopener noreferrer" class="hover:text-white/80 transition-colors">{footer.instagram.official}</a></p>
              <p class="pl-[4.2rem] lg:pl-[5.5rem]"><a href={`https://www.instagram.com/${footer.instagram.global}/`} target="_blank" rel="noopener noreferrer" class="hover:text-white/80 transition-colors">{footer.instagram.global}</a></p>
              <p class="pl-[4.2rem] lg:pl-[5.5rem]"><a href={`https://www.instagram.com/${footer.instagram.sg}/`} target="_blank" rel="noopener noreferrer" class="hover:text-white/80 transition-colors">{footer.instagram.sg}</a></p>
            </div>
          </div>
        </div>

        <!-- Contact us -->
        <div>
          <h3 class="text-xs lg:text-sm font-semibold tracking-wide mb-2 lg:mb-4">Contact us</h3>
          <address class="not-italic space-y-1 lg:space-y-2 text-xs lg:text-sm text-white/60 leading-relaxed">
            <p>TEL <a href={footer.phoneTel} class="hover:text-white/80 transition-colors">{footer.phone}</a></p>
            <p>E-MAIL <a href={`mailto:${footer.email}`} class="hover:text-white/80 transition-colors">{footer.email}</a></p>
            <p><span data-i18n="footer.partnership">{t("footer.partnership")}</span> <a href={`mailto:${footer.partnerEmail}`} class="hover:text-white/80 transition-colors">{footer.partnerEmail}</a></p>
          </address>
        </div>
      </div>
    </div>

    <!-- Service Links for SEO -->
    <nav class="mt-6 lg:mt-10 pt-4 lg:pt-6 border-t border-white/10 flex flex-wrap gap-x-5 gap-y-2 text-[10px] lg:text-xs text-white/40" aria-label={isEn ? 'Site links' : '서비스 바로가기'}>
      {serviceLinks.map((l) => (
        <a href={l.href} class="hover:text-white/70 transition-colors" data-i18n={l.i18n}>{l.label}</a>
      ))}
    </nav>
  </div>
</footer>
