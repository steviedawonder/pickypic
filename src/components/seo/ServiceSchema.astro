---
import { company } from '@data/company';
import { jsonLd, pageUrl, serviceNode } from '@data/structuredData';

interface Props {
  serviceName?: string;
  serviceType?: string;
  description?: string;
  /** Countries the page's service covers; defaults to Korea and Singapore. */
  areaServed?: ('KR' | 'SG')[];
  /** Limit the catalogue to the models the page is about (English model names). */
  models?: string[];
}

// The catalog was Korean-only once, so an English page shipped Hangul inside
// its own structured data. Split on the route.
const isEn = Astro.url.pathname.startsWith('/en');

const {
  serviceName = isEn ? 'Photo Booth Rental' : '포토부스 렌탈 서비스',
  serviceType = 'Photo Booth Rental',
  description = isEn ? company.descriptionEn : company.description,
  areaServed,
  models,
} = Astro.props;

// The provider is referenced by @id rather than re-described, so it is the same
// company node BaseLayout emits on every page.
const service = serviceNode({
  url: pageUrl(Astro.url.pathname),
  lang: isEn ? 'en' : 'ko',
  name: serviceName,
  serviceType,
  description,
  areaServed,
  models,
});
---

<script type="application/ld+json" set:html={jsonLd([service])} />
