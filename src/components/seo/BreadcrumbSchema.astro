---
import { breadcrumbNode, jsonLd, pageUrl, type Crumb } from '@data/structuredData';

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;
const lang = Astro.url.pathname.startsWith('/en') ? 'en' : 'ko';

// Crumb URLs come from pageUrl(), the same function that builds the canonical
// tag. Concatenating onto Astro.site used to yield "https://picky-pic.com//about".
const breadcrumbList = breadcrumbNode(pageUrl(Astro.url.pathname), items, lang);
---

<script type="application/ld+json" set:html={jsonLd([breadcrumbList])} />

<!-- Visual Breadcrumb -->
<nav aria-label="Breadcrumb" class="mx-auto max-w-7xl px-6 lg:px-8 pt-18 pb-1">
  <ol class="flex items-center gap-2 text-xs text-secondary">
    {items.map((item, i) => (
      <>
        {i > 0 && <span class="text-border-default">/</span>}
        {i < items.length - 1 ? (
          <li>
            <a href={item.href} class="hover:text-primary transition-colors">{item.name}</a>
          </li>
        ) : (
          <li class="text-primary font-medium" aria-current="page">{item.name}</li>
        )}
      </>
    ))}
  </ol>
</nav>
