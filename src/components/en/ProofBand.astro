---
/**
 * The three facts a cold US visitor needs in the first eight seconds.
 * English pages only.
 *
 * Numerals are set in Bebas Neue — short all-caps figures are exactly what a
 * condensed grotesque is for. They do NOT count up: a ticking number is a
 * template tic and reads as marketing rather than fact.
 *
 * Uses .section-dark (already in global.css) so this is the one inverted band
 * in an otherwise white page — an accent inside the monochrome system, not a
 * second visual dialect.
 */
const facts = [
  { figure: '16,000+', label: 'Brand events delivered' },
  { figure: '500+', label: 'Booths in operation' },
  { figure: '9', label: 'Models in production' },
];
---

<section class="section-dark py-12 lg:py-18">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="grid grid-cols-3 divide-x divide-white/15 gs-stagger">
      {facts.map((f) => (
        <div class="px-3 first:pl-0 lg:px-8 lg:first:pl-0">
          <p class="font-stencil text-[clamp(2.25rem,6vw,5rem)] leading-[0.85] text-white">{f.figure}</p>
          <p class="mt-3 text-[10px] lg:text-[11px] font-semibold uppercase tracking-[0.25em] text-white/50">{f.label}</p>
        </div>
      ))}
    </div>
  </div>
</section>
