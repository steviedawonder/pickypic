---
import '../styles/global.css';
import Navbar from '@components/common/Navbar.astro';
import Footer from '@components/common/Footer.astro';
import FloatingContactButton from '@components/common/FloatingContactButton.astro';
import { getPair, switchTarget } from '@data/i18nPairs';
import {
  ORG_ID, pageUrl, assetUrl, isoDate, orgNode, orgRef, websiteNode, webPageNode, jsonLd,
  type Node,
} from '@data/structuredData';
import { sanityClient } from '../sanity/client';

let siteSettings: any = null;
try {
  siteSettings = await sanityClient.fetch(`*[_type == "siteSettings"][0] {
    headScripts, headMeta, headCustomCss, bodyStartScripts, bodyEndScripts,
    gtmContainerId, ga4MeasurementId, naverAnalyticsId, kakaoPixelId, metaPixelId,
    googleSiteVerification, naverSiteVerification, chatPluginCode
  }`);
} catch (e) { /* silent fail */ }

interface ArticleMeta {
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  section?: string;
  tags?: string[];
}

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  /** Real pixel size of ogImage. Omitted from the tags when unknown rather than guessed. */
  ogImageWidth?: number;
  ogImageHeight?: number;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  articleMeta?: ArticleMeta;
  /** schema.org type of this page's WebPage node, e.g. 'AboutPage', 'CollectionPage'. */
  pageType?: string;
  /** Page-specific JSON-LD nodes, merged into the page's single @graph. */
  schema?: Node[];
}

// Locale comes from the URL, not a prop. A prop can be forgotten on one page
// and that page then ships as Korean without anyone noticing; the path can't lie.
const isEn = Astro.url.pathname.startsWith('/en');
const lang = isEn ? 'en' : 'ko';

const {
  title = isEn
    ? 'PICKYPIC | Receipt Photo Booths, Handmade in Korea'
    : `포토부스 대여 · 렌탈 · 매매 전문 | 피키픽 PICKYPIC`,
  description = isEn
    ? 'A receipt photo booth that prints on standard thermal paper — no ink, no cartridges, no subscription. Handmade in Korea, 500+ booths in operation, 16,000+ brand events. Ships worldwide.'
    : '포토부스 대여·렌탈·매매 전문 피키픽(PICKYPIC). 스탠드형·테이블형·부스형 9종 라인업, 브랜드 팝업·기업 행사·웨딩까지 맞춤형 포토부스를 제공합니다. 누적 16,000건+ 운영 경험. 무료 견적 문의.',
  ogImage,
  ogImageWidth,
  ogImageHeight,
  ogType = 'website',
  noindex = false,
  articleMeta,
  pageType = 'WebPage',
  schema = [],
} = Astro.props;

// One canonical form everywhere: no trailing slash (vercel.json 301s the other
// form). Built from the path, never the raw request, so /blog and /blog/ — both
// reachable on SSR routes — can't each claim to be canonical.
const canonicalURL = pageUrl(Astro.url.pathname);

// hreflang is emitted only for pages that actually have a counterpart.
const pair = noindex ? null : getPair(Astro.url.pathname);

// The default share image is the 1440×930 home hero; a page that passes its own
// image passes its size too, or the size tags are left out.
const DEFAULT_OG_IMAGE = '/images/hero/main-1.jpg';
const isDefaultOg = !ogImage || ogImage === DEFAULT_OG_IMAGE;
const ogImageUrl = assetUrl(ogImage ?? DEFAULT_OG_IMAGE);
const ogWidth = isDefaultOg ? 1440 : ogImageWidth;
const ogHeight = isDefaultOg ? 930 : ogImageHeight;

// One @graph per page. The full company node goes on the pages Google reads it
// from (home and about); everywhere else a slim node keeps { "@id": ORG_ID }
// references resolvable.
const canonicalPathname = new URL(canonicalURL).pathname;
const isCompanyPage = ['/', '/en', '/about'].includes(canonicalPathname);
const graph: Node[] = [
  isCompanyPage ? orgNode(lang) : orgRef(),
  websiteNode(),
  webPageNode({
    url: canonicalURL,
    type: pageType,
    name: title,
    description,
    lang,
    image: ogImage ? ogImageUrl : undefined,
    about: isCompanyPage ? ORG_ID : undefined,
    mainEntity: pageType === 'AboutPage' ? ORG_ID : undefined,
  }),
  ...schema,
];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {/* No meta keywords: Google and Naver don't read it, and Bing treats a stuffed
        list as a spam signal. Per-bot googlebot/bingbot/yeti tags are gone too —
        "robots" covers every crawler, and those copies said "index" even on
        noindex pages. */}
    <meta name="author" content={isEn ? 'PICKYPIC' : '피키픽 PICKYPIC'} />
    <meta name="generator" content={Astro.generator} />
    {noindex ? (
      <meta name="robots" content="noindex, follow" />
    ) : (
      <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    )}
    <meta name="theme-color" content="#ffffff" />

    <!-- Google Search Console -->
    <meta name="google-site-verification" content="JW_ZpRY2Qb3YRrWB2wW7fOyxuIAox4hidSEUQHRLOks" />
    <meta name="google-site-verification" content={siteSettings?.googleSiteVerification || 'XALCn56VEHtBbtrm49DnZH2WdT3ccOizTGKTkTHsIns'} />
    <!-- Owner: pickypic-indexing service account (for Indexing API) -->
    <meta name="google-site-verification" content="p4kFqeT5UaO2hZoZRPFeSIbtVbpgU6WdoL9NLeeSUdA" />

    <!-- Naver Search Advisor -->
    <meta name="naver-site-verification" content={siteSettings?.naverSiteVerification || '062e44a0df871ea7efc1955b667ed80346b8d5ef'} />
    <meta name="naver-site-verification" content="b3610845d8160c7330c915478db981de196bd1ec" />

    {/* Emitted only for paths in src/data/i18nPairs.ts; both locales read that
        one table, so the annotations are reciprocal by construction. See the
        file for why ja is omitted and why x-default points at English.
        JSX-style comment: it stays in source and never reaches the browser. */}
    {pair && (
      <>
        <link rel="alternate" hreflang="ko" href={pageUrl(pair.ko)} />
        <link rel="alternate" hreflang="en" href={pageUrl(pair.en)} />
        <link rel="alternate" hreflang="x-default" href={pageUrl(pair.en)} />
      </>
    )}

    <!-- Google Tag Manager -->
    <script is:inline define:vars={{ gtmId: siteSettings?.gtmContainerId || 'GTM-KDRFNN4H' }}>
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
      new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
      j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
      'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
      })(window,document,'script','dataLayer',gtmId);
    </script>

    <!-- GA4 (only if set AND GTM is not set in Sanity) -->
    {siteSettings?.ga4MeasurementId && !siteSettings?.gtmContainerId && (
      <script async src={`https://www.googletagmanager.com/gtag/js?id=${siteSettings.ga4MeasurementId}`}></script>
    )}
    {siteSettings?.ga4MeasurementId && !siteSettings?.gtmContainerId && (
      <script is:inline define:vars={{ ga4Id: siteSettings.ga4MeasurementId }}>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', ga4Id);
      </script>
    )}

    <!-- Kakao Pixel -->
    {siteSettings?.kakaoPixelId && (
      <script is:inline define:vars={{ kakaoId: siteSettings.kakaoPixelId }}>
        !function(e,t,n,a,s,c){e.kakaoPixel||(s=e.kakaoPixel=function(){s.queue.push(arguments)},s.queue=[],
        c=t.createElement(n),c.async=1,c.src='https://t1.daumcdn.net/kas/static/kp.js',
        t.head.appendChild(c))}(window,document,'script');
        kakaoPixel(kakaoId).pageView();
      </script>
    )}

    <!-- Meta (Facebook) Pixel -->
    {siteSettings?.metaPixelId && (
      <script is:inline define:vars={{ metaId: siteSettings.metaPixelId }}>
        !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?
        n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;
        n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;
        t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,
        document,'script','https://connect.facebook.net/en_US/fbevents.js');
        fbq('init', metaId);
        fbq('track', 'PageView');
      </script>
    )}

    <!-- Custom head meta from Sanity -->
    {siteSettings?.headMeta && <Fragment set:html={siteSettings.headMeta} />}

    <!-- Custom head scripts from Sanity -->
    {siteSettings?.headScripts && <Fragment set:html={siteSettings.headScripts} />}

    <!-- Custom head CSS from Sanity -->
    {siteSettings?.headCustomCss && <style set:html={siteSettings.headCustomCss} />}

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    {ogWidth && ogHeight && (
      <>
        <meta property="og:image:width" content={String(ogWidth)} />
        <meta property="og:image:height" content={String(ogHeight)} />
      </>
    )}
    <meta property="og:image:alt" content={isEn
      ? 'PICKYPIC — receipt photo booths, handmade in Korea'
      : '피키픽 PICKYPIC 포토부스 - 포토부스 대여 · 렌탈 · 매매 전문'} />
    <meta property="og:locale" content={isEn ? 'en_US' : 'ko_KR'} />
    <meta property="og:site_name" content="PICKYPIC" />
    {articleMeta?.publishedTime && <meta property="article:published_time" content={isoDate(articleMeta.publishedTime)} />}
    {articleMeta?.modifiedTime && <meta property="article:modified_time" content={isoDate(articleMeta.modifiedTime)} />}
    {articleMeta?.author && <meta property="article:author" content={articleMeta.author} />}
    {articleMeta?.section && <meta property="article:section" content={articleMeta.section} />}
    {articleMeta?.tags?.map(tag => <meta property="article:tag" content={tag} />)}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:site" content="@pickypic_official" />

    <!-- Favicon -->
    {/* Square icons (Naver and Google ignore non-square favicons; the 337×312
        logo was one). Absolute URLs per Naver's favicon guide. The
        apple-touch tile is white because iOS paints transparency black. */}
    <link rel="icon" type="image/png" sizes="192x192" href="https://picky-pic.com/images/common/icon-192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="https://picky-pic.com/images/common/apple-touch-icon-180.png" />

    {/* A noindex page gets no canonical: "don't index this, index that" is a
        mixed signal, and a 404 has no URL worth pointing at. */}
    {!noindex && <link rel="canonical" href={canonicalURL} />}

    <!-- RSS Feed -->
    {/* The blog is Korean-only, so /en/ does not advertise its feed. */}
    {!isEn && (
      <link rel="alternate" type="application/rss+xml" title="피키픽 포토부스 블로그" href="https://picky-pic.com/blog/rss.xml" />
    )}

    <!-- Font Preload: Bebas Neue (local, Latin subset — every Bebas use is Latin) -->
    <link rel="preload" href="/fonts/bebas-neue-latin-v1.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Google Fonts: Noto Sans KR & Montserrat -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400..700&family=Noto+Sans+KR:wght@400..700&display=swap"
      rel="stylesheet"
    />

    {/* Structured data: company, site and page as one @graph (built in the
        frontmatter from src/data/structuredData.ts). */}
    <script type="application/ld+json" set:html={jsonLd(graph)} />

    <!-- Page-specific structured data slot -->
    <slot name="head" />

    <title>{title}</title>
    {!isEn && (
      <script is:inline>
        (function() {
          var lang = localStorage.getItem('pickypic-lang');
          if (lang && lang !== 'ko') {
            document.documentElement.style.visibility = 'hidden';
            // Only i18n.ts clears this. If that chunk fails to load or throws,
            // the visitor would sit on a permanently blank page — so give up
            // hiding after 2s and show the Korean text rather than nothing.
            setTimeout(function() {
              document.documentElement.style.visibility = '';
            }, 2000);
          }
        })();
      </script>
    )}
  </head>
  <body class="bg-white text-primary antialiased">
    <!-- Google Tag Manager (noscript) -->
    <noscript>
      <iframe src={`https://www.googletagmanager.com/ns.html?id=${siteSettings?.gtmContainerId || 'GTM-KDRFNN4H'}`}
        height="0" width="0" style="display:none;visibility:hidden"></iframe>
    </noscript>

    <!-- Body start scripts from Sanity -->
    {siteSettings?.bodyStartScripts && <Fragment set:html={siteSettings.bodyStartScripts} />}

    {/* Overseas visitors get an offer, not a redirect; i18n.ts reveals this
        after the geo check. Pinned to the bottom because the navbar is
        `fixed top-0 z-50` — an in-flow bar at the top of <body> renders
        underneath it and shifts the page down when the geo fetch resolves.
        JSX-style comment: stays in source, never reaches the browser. */}
    {!isEn && (
      <div id="en-suggest-banner" data-nosnippet class="hidden fixed bottom-0 left-0 right-0 z-[60] bg-primary text-white text-sm shadow-[0_-2px_12px_rgba(0,0,0,0.15)]">
        <div class="mx-auto max-w-7xl px-6 lg:px-8 py-2.5 flex items-center justify-between gap-4">
          <a href={switchTarget(Astro.url.pathname, 'en')} class="hover:underline">
            View this page in English &rarr;
          </a>
          <button type="button" class="en-banner-close shrink-0 opacity-70 hover:opacity-100" aria-label="Dismiss">&#10005;</button>
        </div>
      </div>
    )}

    <Navbar />
    <main>
      <slot />
    </main>
    <Footer />
    <FloatingContactButton />

    <!-- i18n Language Switching -->
    <script>
      import '../i18n/i18n';
    </script>

    <!-- GSAP ScrollTrigger -->
    <script>
      import { gsap } from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';

      gsap.registerPlugin(ScrollTrigger);

      function initAnimations() {
        // Only what starts below the fold is animated. A fromTo() on a visible
        // heading or hero image set it to opacity 0 until this bundle ran, so
        // the first thing on screen appeared late and LCP was timed from the
        // end of the tween. Rects are all read up front, before any tween
        // writes styles, so this costs one layout instead of one per element.
        const vh = window.innerHeight;
        const belowFold = (selector: string) =>
          gsap.utils.toArray<HTMLElement>(selector).filter((el) => el.getBoundingClientRect().top >= vh);
        const [fadeUp, fadeIn, slideLeft, slideRight, scaleIn, staggered] = [
          '.gs-fade-up', '.gs-fade-in', '.gs-slide-left', '.gs-slide-right', '.gs-scale-in', '.gs-stagger',
        ].map(belowFold);

        // Fade up
        fadeUp.forEach((el) => {
          const element = el as HTMLElement;
          gsap.fromTo(
            element,
            { opacity: 0, y: 60 },
            {
              opacity: 1,
              y: 0,
              duration: 1,
              ease: 'power3.out',
              scrollTrigger: {
                trigger: element,
                start: 'top 85%',
                once: true,
              },
            }
          );
        });

        // Fade in
        fadeIn.forEach((el) => {
          const element = el as HTMLElement;
          gsap.fromTo(
            element,
            { opacity: 0 },
            {
              opacity: 1,
              duration: 1.2,
              ease: 'power2.out',
              scrollTrigger: {
                trigger: element,
                start: 'top 85%',
                once: true,
              },
            }
          );
        });

        // Slide left
        slideLeft.forEach((el) => {
          const element = el as HTMLElement;
          const xOffset = window.innerWidth >= 768 ? -80 : -40;
          gsap.fromTo(
            element,
            { opacity: 0, x: xOffset },
            {
              opacity: 1,
              x: 0,
              duration: 1,
              ease: 'power3.out',
              scrollTrigger: {
                trigger: element,
                start: 'top 85%',
                once: true,
              },
            }
          );
        });

        // Slide right
        slideRight.forEach((el) => {
          const element = el as HTMLElement;
          gsap.fromTo(
            element,
            { opacity: 0, x: 80 },
            {
              opacity: 1,
              x: 0,
              duration: 1,
              ease: 'power3.out',
              scrollTrigger: {
                trigger: element,
                start: 'top 85%',
                once: true,
              },
            }
          );
        });

        // Scale in
        scaleIn.forEach((el) => {
          const element = el as HTMLElement;
          gsap.fromTo(
            element,
            { opacity: 0, scale: 0.9 },
            {
              opacity: 1,
              scale: 1,
              duration: 1.2,
              ease: 'power2.out',
              scrollTrigger: {
                trigger: element,
                start: 'top 85%',
                once: true,
              },
            }
          );
        });

        // Stagger children
        staggered.forEach((el) => {
          const element = el as HTMLElement;
          const children = element.children;
          gsap.fromTo(
            children,
            { opacity: 0, y: 40 },
            {
              opacity: 1,
              y: 0,
              duration: 0.8,
              ease: 'power3.out',
              stagger: 0.1,
              scrollTrigger: {
                trigger: element,
                start: 'top 85%',
                once: true,
              },
            }
          );
        });
      }

      document.addEventListener('DOMContentLoaded', initAnimations);
      document.addEventListener('astro:after-swap', initAnimations);
    </script>

    {/* The Channel Talk remover that used to sit here is gone: GTM no longer
        injects Channel Talk, and its [class*="channel"] sweep (every second and
        on every DOM change) would have deleted any future element whose class
        merely contains "channel". If the widget ever comes back, pause its tag
        in GTM instead.

        Contact clicks go to the dataLayer so GTM can count phone / Kakao /
        email / SmartStore leads, which no tag measured before. */}
    <script is:inline>
      document.addEventListener('click', function (e) {
        var a = e.target instanceof Element ? e.target.closest('a[href]') : null;
        if (!a) return;
        var href = a.getAttribute('href') || '';
        var method = href.indexOf('tel:') === 0 ? 'phone'
          : href.indexOf('mailto:') === 0 ? 'email'
          : href.indexOf('pf.kakao.com') !== -1 ? 'kakao_channel'
          : href.indexOf('smartstore.naver.com') !== -1 ? 'smartstore'
          : null;
        if (!method) return;
        var where = a.closest('#floating-btns') ? 'floating'
          : a.closest('header') ? 'header'
          : a.closest('footer') ? 'footer'
          : 'content';
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({ event: 'contact_click', contact_method: method, link_location: where });
      });
    </script>

    {/* Naver Analytics, when an ID is set in admin. Naver's loader must have run
        before wcs_do(), and wcs_add has to be a real global — the old async
        version in <head> did neither, so a filled-in ID sent nothing. */}
    {siteSettings?.naverAnalyticsId && (
      <script is:inline src="https://wcs.naver.net/wcslog.js"></script>
    )}
    {siteSettings?.naverAnalyticsId && (
      <script is:inline define:vars={{ naverId: siteSettings.naverAnalyticsId }}>
        window.wcs_add = window.wcs_add || {};
        window.wcs_add['wa'] = naverId;
        if (window.wcs) { window.wcs_do(); }
      </script>
    )}

    <!-- Chat plugin from Sanity -->
    {siteSettings?.chatPluginCode && <Fragment set:html={siteSettings.chatPluginCode} />}

    <!-- Body end scripts from Sanity -->
    {siteSettings?.bodyEndScripts && <Fragment set:html={siteSettings.bodyEndScripts} />}
  </body>
</html>
